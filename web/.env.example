# Copy to web/.env.local (never commit it).

# Which networks the app offers, comma-separated. The first is the default; with more than one,
# a switcher appears in the header.
#   aevum = QDay Aevum testnet (chain 44005)
#   fork  = local fork of Aevum on 127.0.0.1:8555 (chain 440050, real tUSD8)
#   local = empty local anvil chain on 127.0.0.1:8545 (chain 31337, MockUSD8)
NEXT_PUBLIC_NETWORKS=aevum,fork

# Your deployed AevumGuardVault contract address on each network.
NEXT_PUBLIC_VAULT_AEVUM=
NEXT_PUBLIC_VAULT_FORK=
NEXT_PUBLIC_VAULT_LOCAL=

# Optional. Only scan events from this block onward in the Audit Feed (speeds up chunked reads).
NEXT_PUBLIC_DEPLOY_BLOCK_AEVUM=
NEXT_PUBLIC_DEPLOY_BLOCK_FORK=

# Optional. Enables WalletConnect (mobile wallets via QR). Free at https://cloud.reown.com
# Without it the app works with injected browser wallets (MetaMask, Rabby, ...).
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional. Source repository URL linked in the header and Docs page.
NEXT_PUBLIC_REPO_URL=

# ---- Server only (no NEXT_PUBLIC_ prefix: never sent to the browser) ----

# Enables gasless EIP-3009 deposits and gasless EIP-712 AI agent spends.
# Use a fresh TEST wallet funded with a small amount of tQDAY. Public anvil keys are
# automatically refused on Aevum testnet (chain 44005).
RELAYER_PRIVATE_KEY=

# Optional. Max transactions the relayer sends per day (per server process). Default 500.
# RELAYER_DAILY_TX_LIMIT=500
# TRUSTED_IP_HEADER=
